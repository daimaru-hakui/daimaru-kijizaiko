# .env.local にコピーして値を設定する

# Firebase クライアント SDK (Firebase コンソール > プロジェクトの設定 > マイアプリ)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise のサイトキー)。未設定なら App Check を初期化しない
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# ローカル開発のみ。Firebase コンソールの App Check で登録したデバッグトークン
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Firebase Admin SDK のサービスアカウント鍵 (JSON を 1 行の文字列で)
FIREBASE_SERVICE_ACCOUNT_KEY=

# /api/cutting-reports (daimaru-portal 連携) 専用の API キー
BACKEND_API_KEY=
